{
  "$id": "devcontour-harness/v1alpha1/work-graph.schema.json",
  "title": "work-graph",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "devcontour-harness/v1alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "connector": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "connector",
        "ref",
        "revision"
      ],
      "additionalProperties": false
    },
    "orders": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "const": "devcontour-harness/v1alpha1"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "connector": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "connector",
              "ref",
              "revision"
            ],
            "additionalProperties": false
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          },
          "goal": {
            "type": "string",
            "minLength": 10,
            "maxLength": 12000
          },
          "acceptance": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 1500
            }
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,30}$"
          },
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "relatedRepositories": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          },
          "writeScope": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
            }
          },
          "dependsOn": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          },
          "gates": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^@?[A-Za-z0-9_-]{1,80}$"
            }
          },
          "consumers": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repositoryId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "gates": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^@?[A-Za-z0-9_-]{1,80}$"
                  }
                }
              },
              "required": [
                "repositoryId",
                "gates"
              ],
              "additionalProperties": false
            }
          },
          "properties": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,200}$"
            }
          },
          "resources": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          },
          "requirements": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^REQ-[A-Za-z0-9_-]{1,64}$"
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 12000
                },
                "gate": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "scenario": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1500
                },
                "testId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "id",
                "source",
                "digest",
                "text",
                "gate",
                "scenario"
              ],
              "additionalProperties": false
            }
          },
          "contracts": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "context": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          }
        },
        "required": [
          "apiVersion",
          "id",
          "source",
          "title",
          "goal",
          "acceptance",
          "role",
          "repositoryId",
          "writeScope"
        ],
        "additionalProperties": false
      }
    },
    "prerequisites": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "resultSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "receipt": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "engine"
                  },
                  "runId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "kind",
                  "runId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "trusted"
                  },
                  "issuer": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "issuer",
                  "digest"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "repositoryId",
          "resultSha",
          "receipt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "id",
    "source",
    "orders"
  ],
  "additionalProperties": false
}
