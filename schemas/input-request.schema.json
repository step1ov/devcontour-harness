{
  "$id": "devcontour-harness/v1alpha1/input-request.schema.json",
  "title": "input-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IR-[a-f0-9]{24}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "question",
        "follow-up"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "workId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "graphId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "callId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "options": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,40}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "consequence": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "label",
              "consequence"
            ],
            "additionalProperties": false
          }
        },
        "recommended": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000
        },
        "affects": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "contract",
              "acceptance",
              "product",
              "api",
              "migration"
            ]
          }
        }
      },
      "required": [
        "question",
        "options",
        "recommended",
        "severity",
        "rationale",
        "affects"
      ],
      "additionalProperties": false
    },
    "effectiveSeverity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "floors": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "declared",
          "critical-path"
        ]
      }
    },
    "criticalHits": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "draft": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 500
              }
            }
          },
          "required": [
            "digest",
            "files"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "originBasis": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "connector": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "connector",
            "ref",
            "revision"
          ],
          "additionalProperties": false
        },
        "graphId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "graphDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "orderDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputPolicy": {
          "type": "object",
          "properties": {
            "threshold": {
              "default": 7,
              "type": "integer",
              "minimum": 1,
              "maximum": 11
            },
            "criticalPaths": {
              "default": [],
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
              }
            }
          },
          "additionalProperties": false
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source",
        "graphId",
        "graphDigest",
        "orderDigest",
        "policyDigest",
        "contextDigest",
        "baseSha",
        "inputPolicy"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "pending",
        "answered",
        "applied",
        "cancelled",
        "superseded"
      ]
    },
    "answers": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "optionId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "clarification",
              "requirement-change"
            ]
          },
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "operator",
                  "lead",
                  "host"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "messageRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "revision",
          "text",
          "optionId",
          "kind",
          "actor",
          "digest",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "originDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "answerDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graphDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "orderDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "round": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "approved": {
                  "type": "boolean"
                },
                "reviewerBinding": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "round",
                "approved",
                "reviewerBinding"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "type": "string",
          "enum": [
            "agent",
            "operator"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "originDigest",
        "answerDigest",
        "graphDigest",
        "orderDigest",
        "policyDigest",
        "contextDigest",
        "review",
        "actor",
        "digest"
      ],
      "additionalProperties": false
    },
    "delivered": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "runId",
        "callId",
        "at"
      ],
      "additionalProperties": false
    },
    "closed": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "by": {
          "type": "string",
          "enum": [
            "operator",
            "lead",
            "host",
            "controller"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "successor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "carry": {
          "type": "boolean"
        },
        "previous": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "by": {
              "type": "string",
              "enum": [
                "operator",
                "lead",
                "host",
                "controller"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "successor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "carry": {
              "type": "boolean"
            }
          },
          "required": [
            "at",
            "by",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "at",
        "by",
        "reason"
      ],
      "additionalProperties": false
    },
    "stale": {
      "type": "object",
      "properties": {
        "targetDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "context",
            "graph",
            "order",
            "policy"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "targetDigest",
        "reason",
        "at"
      ],
      "additionalProperties": false
    },
    "normalized": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "kind",
    "blocking",
    "workId",
    "graphId",
    "runId",
    "attempt",
    "callId",
    "question",
    "effectiveSeverity",
    "floors",
    "criticalHits",
    "draft",
    "createdAt",
    "originBasis",
    "lifecycle",
    "answers",
    "version"
  ],
  "additionalProperties": false
}
