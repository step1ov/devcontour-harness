{
  "$id": "devcontour-harness/v1alpha1/stop-diagnosis.schema.json",
  "title": "stop-diagnosis",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "INVALID_INPUT",
        "UNSUPPORTED_COMMAND",
        "UNSUPPORTED_VERSION",
        "GRAPH_CYCLE",
        "GRAPH_UNKNOWN_DEPENDENCY",
        "GRAPH_DUPLICATE_ID",
        "GATE_UNKNOWN",
        "GATE_GROUP_CYCLE",
        "REVIEWER_SAME_VENDOR",
        "REVIEWER_MISSING",
        "RESPONSE_TOO_LARGE",
        "APPROVAL_STALE",
        "APPROVAL_REQUIRED",
        "LEASE_STALE",
        "CONTROLLER_BUSY",
        "PAUSED",
        "NOT_READY",
        "SCOPE_VIOLATION",
        "GATE_FAILED",
        "REVIEW_REJECTED",
        "BUDGET_EXHAUSTED",
        "BUDGET_UNKNOWN",
        "ATTEMPTS_EXHAUSTED",
        "REVISION_CONFLICT",
        "CANCELLED",
        "NOT_FOUND",
        "PATH_CONFLICT",
        "STATE_VERSION_UNSUPPORTED",
        "RUNTIME_UNAVAILABLE",
        "REVIEW_PROTOCOL_INVALID",
        "SANDBOX_UNAVAILABLE",
        "GIT_FAILED",
        "STORAGE_FAILED",
        "DELIVERY_FAILED",
        "INTERNAL"
      ]
    },
    "cause": {
      "type": "string",
      "enum": [
        "provider-auth",
        "environment",
        "timeout",
        "stale-base",
        "empty-result",
        "unfinished",
        "scope-violation",
        "gate",
        "review",
        "review-protocol",
        "merge",
        "cancelled",
        "budget",
        "unknown",
        "runtime-missing",
        "controller-busy",
        "operator-pause",
        "approval-required",
        "not-ready"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "preflight",
        "claim",
        "implementation",
        "gates",
        "review",
        "integration",
        "delivery"
      ]
    },
    "actor": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "controller",
            "lead",
            "user"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "none",
        "wait",
        "review-plan",
        "retry",
        "diagnose-failure",
        "reset-attempts",
        "raise-budget",
        "replan-dependents",
        "recovery-decision",
        "user-decision",
        "resume-queue",
        "fix-environment",
        "fix-access"
      ]
    },
    "retryPlanned": {
      "type": "boolean"
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "attempt",
              "evidence",
              "event",
              "doctor"
            ]
          },
          "id": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "workId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "cause",
    "phase",
    "actor",
    "action",
    "retryPlanned",
    "message",
    "evidence"
  ],
  "additionalProperties": false
}
