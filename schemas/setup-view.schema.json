{
  "$id": "devcontour-harness/v1alpha1/setup-view.schema.json",
  "title": "setup-view",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "viewVersion": {
      "type": "number",
      "const": 1
    },
    "viewRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "producerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stateVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "producer",
        "producerVersion",
        "stateVersion",
        "token"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "setup"
        },
        "lines": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "required": [
        "name",
        "lines"
      ],
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "properties": {
        "waitingFor": {
          "type": "string",
          "enum": [
            "project",
            "policy"
          ]
        }
      },
      "required": [
        "waitingFor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "viewVersion",
    "viewRevision",
    "generatedAt",
    "source",
    "stage",
    "setup"
  ],
  "additionalProperties": false
}
