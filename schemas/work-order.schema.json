{
  "$id": "devcontour-harness/v1alpha1/work-order.schema.json",
  "title": "work-order",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "devcontour-harness/v1alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "connector": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "connector",
        "ref",
        "revision"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "maxLength": 12000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "acceptance": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1500,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "relatedRepositories": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      }
    },
    "writeScope": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
      }
    },
    "dependsOn": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      }
    },
    "gates": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^@?[A-Za-z0-9_-]{1,80}$"
      }
    },
    "consumers": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "gates": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^@?[A-Za-z0-9_-]{1,80}$"
            }
          }
        },
        "required": [
          "repositoryId",
          "gates"
        ],
        "additionalProperties": false
      }
    },
    "properties": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,200}$"
      }
    },
    "resources": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      }
    },
    "requirements": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[A-Za-z0-9_-]{1,64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 12000
          },
          "gate": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "scenario": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1500
          },
          "testId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "id",
          "source",
          "digest",
          "text",
          "gate",
          "scenario"
        ],
        "additionalProperties": false
      }
    },
    "contracts": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "context": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      }
    }
  },
  "required": [
    "apiVersion",
    "id",
    "source",
    "title",
    "goal",
    "acceptance",
    "role",
    "repositoryId",
    "writeScope"
  ],
  "additionalProperties": false
}
