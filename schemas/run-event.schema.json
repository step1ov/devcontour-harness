{
  "$id": "devcontour-harness/v1alpha1/run-event.schema.json",
  "title": "run-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "devcontour-harness/v1alpha1"
    },
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "type": {
      "type": "string",
      "enum": [
        "graph.registered",
        "graph.reviewed",
        "graph.approved",
        "work.ready",
        "work.held",
        "attempt.claimed",
        "attempt.phase",
        "attempt.gate",
        "attempt.review",
        "attempt.failed",
        "attempt.expired",
        "attempt.cancelled",
        "attempt.recovered",
        "work.accepted",
        "work.blocked",
        "control.paused",
        "control.resumed",
        "controller.acquired",
        "controller.released",
        "budget.blocked",
        "delivery.pending",
        "delivery.delivered",
        "delivery.failed",
        "delivery.conflict"
      ]
    },
    "graphId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "workId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "apiVersion",
    "seq",
    "at",
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema1": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "$ref": "#/$defs/__schema0"
        }
      ]
    }
  }
}
