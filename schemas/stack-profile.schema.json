{
  "$id": "devcontour-harness/v1alpha1/stack-profile.schema.json",
  "title": "stack-profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
    },
    "extends": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "gates": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "check",
              "test"
            ]
          },
          "command": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeoutMs": {
            "default": 120000,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "report": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "junit"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
              }
            },
            "required": [
              "type",
              "path"
            ],
            "additionalProperties": false
          },
          "property": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
              }
            },
            "additionalProperties": false
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "prepare": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "command": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeoutMs": {
            "default": 120000,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 3600000
          }
        },
        "required": [
          "id",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "inherit": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!HARNESS_|DEVCONTOUR_)[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "values": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!HARNESS_|DEVCONTOUR_)[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "secrets": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!HARNESS_|DEVCONTOUR_)[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "setup": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeoutMs": {
                "default": 120000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600000
              }
            },
            "required": [
              "id",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "ready": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeoutMs": {
                "default": 120000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600000
              }
            },
            "required": [
              "id",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "teardown": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeoutMs": {
                "default": 120000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600000
              }
            },
            "required": [
              "id",
              "command"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "teardown"
      ],
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "tools": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(>=)?\\d+(\\.\\d+){0,2}$"
          }
        },
        "packageManagers": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "anyOf": [
              {
                "type": "string",
                "const": "."
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "npm",
              "pnpm"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "protectedPaths": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
      }
    },
    "generatedPaths": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
      }
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "runTimeoutMs": {
      "type": "integer",
      "minimum": 60000,
      "maximum": 7200000
    },
    "roles": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "runtime": {
            "type": "string",
            "enum": [
              "codex",
              "claude"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          },
          "toolProfile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "writePaths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
            }
          },
          "reviewer": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "string",
                "enum": [
                  "codex",
                  "claude"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh"
                ]
              },
              "toolProfile": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "required": [
              "runtime"
            ],
            "additionalProperties": false
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "requiresContract": {
            "type": "boolean"
          }
        },
        "required": [
          "runtime"
        ],
        "additionalProperties": false
      }
    },
    "contextPacks": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "roles": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,30}$"
            }
          },
          "files": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
            }
          },
          "references": {
            "default": [],
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
            }
          }
        },
        "required": [
          "id",
          "version",
          "files"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version"
  ],
  "additionalProperties": false
}
