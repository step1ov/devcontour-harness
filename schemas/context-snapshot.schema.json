{
  "$id": "devcontour-harness/v1alpha1/context-snapshot.schema.json",
  "title": "context-snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "devcontour-harness/v1alpha1"
    },
    "sources": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "repositoryId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "required": {
            "type": "boolean"
          },
          "files": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "encoding": {
                          "type": "string",
                          "const": "utf8"
                        },
                        "data": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "encoding",
                        "data"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "encoding": {
                          "type": "string",
                          "const": "base64"
                        },
                        "data": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                        }
                      },
                      "required": [
                        "encoding",
                        "data"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "path",
                "digest",
                "bytes",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "references": {
            "default": [],
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?!\\/)(?!.*[\\\\:*?\\[\\]\\x00])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?=.{1,500}$).+$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "encoding": {
                          "type": "string",
                          "const": "utf8"
                        },
                        "data": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "encoding",
                        "data"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "encoding": {
                          "type": "string",
                          "const": "base64"
                        },
                        "data": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                        }
                      },
                      "required": [
                        "encoding",
                        "data"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "path",
                "digest",
                "bytes",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hostDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "version",
          "required",
          "files",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "missing": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "sources"
  ],
  "additionalProperties": false
}
