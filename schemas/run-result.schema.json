{
  "$id": "devcontour-harness/v1alpha1/run-result.schema.json",
  "title": "run-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "devcontour-harness/v1alpha1"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "blocked",
        "cancelled",
        "stopped"
      ]
    },
    "workOrderId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "graphId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "connector": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "connector",
        "ref",
        "revision"
      ],
      "additionalProperties": false
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^refs\\/heads\\/[A-Za-z0-9][A-Za-z0-9/_.-]{0,200}$"
    },
    "shas": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "integration": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "result": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "harnessVersion": {
          "type": "string",
          "minLength": 1
        },
        "stateVersion": {
          "type": "number",
          "const": 1
        },
        "workOrderDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graphDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checks": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "harnessVersion",
        "stateVersion",
        "workOrderDigest",
        "graphDigest",
        "policyDigest"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "check",
              "review",
              "property",
              "consumer"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "candidate",
              "integration"
            ]
          },
          "gate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "passed": {
            "type": "boolean"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "consumer": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "reviewer": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "string",
                "enum": [
                  "codex",
                  "claude",
                  "fixture"
                ]
              },
              "model": {
                "type": "string"
              },
              "sameVendor": {
                "type": "boolean"
              }
            },
            "required": [
              "runtime",
              "sameVendor"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "phase",
          "gate",
          "sha",
          "passed",
          "digest",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "rule": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "stopReason": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_INPUT",
            "UNSUPPORTED_COMMAND",
            "UNSUPPORTED_VERSION",
            "GRAPH_CYCLE",
            "GRAPH_UNKNOWN_DEPENDENCY",
            "GRAPH_DUPLICATE_ID",
            "GATE_UNKNOWN",
            "GATE_GROUP_CYCLE",
            "REVIEWER_SAME_VENDOR",
            "REVIEWER_MISSING",
            "APPROVAL_STALE",
            "APPROVAL_REQUIRED",
            "LEASE_STALE",
            "CONTROLLER_BUSY",
            "PAUSED",
            "NOT_READY",
            "SCOPE_VIOLATION",
            "GATE_FAILED",
            "REVIEW_REJECTED",
            "BUDGET_EXHAUSTED",
            "BUDGET_UNKNOWN",
            "ATTEMPTS_EXHAUSTED",
            "REVISION_CONFLICT",
            "CANCELLED",
            "NOT_FOUND",
            "STATE_VERSION_UNSUPPORTED",
            "RUNTIME_UNAVAILABLE",
            "SANDBOX_UNAVAILABLE",
            "GIT_FAILED",
            "STORAGE_FAILED",
            "DELIVERY_FAILED",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "apiVersion",
    "outcome",
    "workOrderId",
    "graphId",
    "source",
    "runId",
    "attempt",
    "repositoryId",
    "targetRef",
    "shas",
    "inputs",
    "evidence",
    "finishedAt"
  ],
  "additionalProperties": false
}
