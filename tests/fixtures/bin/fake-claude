#!/usr/bin/env node
// FIXTURE ONLY. Подставной CLI codex/claude для тестов механики harness:
// говорит по протоколу CLI, но ответы берёт из сценария, а не из модели.
import { readFileSync, writeFileSync, mkdirSync, rmSync, existsSync, chmodSync } from 'node:fs';
import { dirname, join, basename } from 'node:path';
import { execFileSync, spawnSync } from 'node:child_process';

const runtime = basename(process.argv[1]).includes('claude') ? 'claude' : 'codex';
const args = process.argv.slice(2);
if (args.includes('--version')) {
  console.log(`fake-${runtime} 0.0.1 (fixture)`);
  process.exit(0);
}
const scenarioPath = process.env.FIXTURE_SCENARIO;
if (!scenarioPath) {
  console.error('Not logged in: FIXTURE_SCENARIO is not set');
  process.exit(1);
}
const scenario = JSON.parse(readFileSync(scenarioPath, 'utf8'));
const arg = (name) => {
  const i = args.indexOf(name);
  return i >= 0 ? args[i + 1] : undefined;
};
const schema =
  runtime === 'codex'
    ? JSON.parse(readFileSync(arg('--output-schema'), 'utf8'))
    : JSON.parse(arg('--json-schema'));
// Разбор ведущего (ответ с `action`) — отдельная роль сценария `lead`.
const role = schema?.properties?.approved
  ? 'reviewer'
  : schema?.properties?.action
    ? 'lead'
    : 'writer';
const counterPath = `${scenarioPath}.${runtime}.${role}.count`;
const index = existsSync(counterPath) ? Number(readFileSync(counterPath, 'utf8')) : 0;
writeFileSync(counterPath, String(index + 1));
const steps = scenario[role] ?? scenario[`${runtime}-${role}`];
const step = Array.isArray(steps) ? steps[Math.min(index, steps.length - 1)] : steps;
if (!step) {
  console.error(`fixture: no ${role} step`);
  process.exit(2);
}
writeFileSync(`${scenarioPath}.${role}.${index}.started`, '');
const prompt = readFileSync(0, 'utf8');
// Ключи окружения вызова (значения — только у FIXTURE_/PROFILE_): тесты проверяют, что профиль применён.
writeFileSync(
  `${scenarioPath}.${runtime}.${role}.${index}.env`,
  JSON.stringify(
    Object.keys(process.env)
      .sort()
      .map((k) => [k, k.startsWith('PROFILE_') || k.startsWith('FIXTURE_') ? process.env[k] : '-']),
  ),
);
if (step.recordPrompt)
  writeFileSync(
    `${scenarioPath}.${role}.${index}.prompt`,
    prompt + '\n---ARGS---\n' + JSON.stringify(args),
  );
// Что исполнитель застал в дереве до своей работы: тесты проверяют наложенный черновик.
if (step.observe)
  writeFileSync(
    `${scenarioPath}.${role}.${index}.observed`,
    JSON.stringify(
      Object.fromEntries(
        step.observe.map((p) => [
          p,
          existsSync(join(process.cwd(), p)) ? readFileSync(join(process.cwd(), p), 'utf8') : null,
        ]),
      ),
    ),
  );
// Изменения до долгого ожидания: попытку обрывают по времени посреди работы.
for (const [path, text] of Object.entries(step.draftFiles ?? {})) {
  mkdirSync(dirname(join(process.cwd(), path)), { recursive: true });
  writeFileSync(join(process.cwd(), path), text);
}
// Ранний вывод и зависший потомок — до ожидания: тесты прерывают вызов по
// времени и проверяют, что потомок остановлен, а вывод замаскирован.
if (step.earlyStderr) process.stderr.write(step.earlyStderr + '\n');
if (step.spawnHanging) {
  const { spawn } = await import('node:child_process');
  const child = spawn(process.execPath, ['-e', 'setInterval(()=>{},1000)'], {
    stdio: 'ignore',
    detached: step.spawnHanging === 'detached',
  });
  writeFileSync(`${scenarioPath}.${role}.${index}.child.pid`, String(child.pid));
  if (step.spawnHanging === 'detached') child.unref();
}
if (step.sleepMs) await new Promise((r) => setTimeout(r, step.sleepMs));
// Шаг держится, пока тест не создаст файл: событие вместо подобранной паузы.
// Предел — на случай, если тест умер и файла не будет.
for (const end = Date.now() + 600_000; step.holdUntil && !existsSync(step.holdUntil); ) {
  if (Date.now() > end) {
    console.error('fixture: holdUntil не дождался файла');
    process.exit(2);
  }
  await new Promise((r) => setTimeout(r, 20));
}
for (const [path, text] of Object.entries(step.files ?? {})) {
  mkdirSync(dirname(join(process.cwd(), path)), { recursive: true });
  writeFileSync(join(process.cwd(), path), text);
}
// Пустые служебные каталоги, как у настоящего CLI (`.claude/.cc-writes`).
for (const path of step.dirs ?? [])
  mkdirSync(join(process.cwd(), path), { recursive: true, mode: 0o700 });
// Права после записи: каталог, открытый всем, или закрытый от чтения.
for (const [path, mode] of Object.entries(step.modes ?? {}))
  chmodSync(join(process.cwd(), path), mode);
for (const path of step.remove ?? []) rmSync(join(process.cwd(), path), { force: true });
// Самопроверка исполнителя: команда из запроса controller на рабочем дереве.
if (step.selfCheck) {
  const found = prompt.match(/Self-check: run `([^`]+)`/);
  let record = { code: null, output: 'self-check не предложен' };
  if (found) {
    const [bin, ...rest] = found[1].split(' ');
    const run = spawnSync(bin, rest, { cwd: process.cwd(), encoding: 'utf8' });
    record = { code: run.status, output: (run.stdout ?? '') + (run.stderr ?? '') };
  }
  writeFileSync(`${scenarioPath}.${role}.${index}.selfcheck`, JSON.stringify(record));
}
if (step.commit)
  execFileSync('git', [
    '-c',
    'user.name=x',
    '-c',
    'user.email=x@x',
    'commit',
    '-qam',
    'agent commit',
    '--allow-empty',
  ]);
// Проверки reviewer через сервер probe — так, как его вызвал бы CLI: по
// команде из конфигурации MCP (codex: -c mcp_servers=…, claude: --mcp-config),
// построчным JSON-RPC по stdio. `$probe:N` в ответе заменяется runId запуска N.
let probeRuns = [];
if (role === 'reviewer' && step.probes) {
  let server;
  if (runtime === 'codex') {
    const config = args.find((a) => a.startsWith('mcp_servers=') && a.includes('devcontour_probe'));
    if (config)
      server = {
        command: JSON.parse(/"command" = ("(?:[^"\\]|\\.)*")/.exec(config)[1]),
        args: JSON.parse(/"args" = (\[[^\]]*\])/.exec(config)[1]),
      };
  } else if (arg('--mcp-config')) {
    server = JSON.parse(readFileSync(arg('--mcp-config'), 'utf8')).mcpServers?.devcontour_probe;
  }
  writeFileSync(`${scenarioPath}.${role}.${index}.probe-server`, JSON.stringify(server ?? null));
  if (server) {
    const { spawn } = await import('node:child_process');
    const child = spawn(server.command, server.args, { stdio: ['pipe', 'pipe', 'inherit'] });
    let buffer = '';
    const waiting = new Map();
    child.stdout.on('data', (chunk) => {
      buffer += chunk.toString();
      let i;
      while ((i = buffer.indexOf('\n')) >= 0) {
        const line = buffer.slice(0, i);
        buffer = buffer.slice(i + 1);
        if (!line.trim()) continue;
        const message = JSON.parse(line);
        waiting.get(message.id)?.(message);
        waiting.delete(message.id);
      }
    });
    let next = 1;
    const request = (method, params) =>
      new Promise((resolve) => {
        const id = next++;
        waiting.set(id, resolve);
        child.stdin.write(JSON.stringify({ jsonrpc: '2.0', id, method, params }) + '\n');
      });
    await request('initialize', {
      protocolVersion: '2025-06-18',
      capabilities: {},
      clientInfo: { name: 'fixture', version: '1' },
    });
    child.stdin.write(
      JSON.stringify({ jsonrpc: '2.0', method: 'notifications/initialized' }) + '\n',
    );
    // Элемент — argv исследовательской команды или готовые аргументы вызова
    // (например, `{ gate: 'domain' }` — объявленный gate по ID).
    const call = (argv) =>
      request('tools/call', {
        name: 'run_check',
        arguments: Array.isArray(argv) ? { argv } : argv,
      }).then((m) => m.result?.structuredContent ?? { error: m.error });
    // Барьер аварии внутри выполняющейся проверки: первый вызов начат, через
    // crashDuringProbe мс controller и сервер проверок убиты SIGKILL, исхода
    // проверки в журнале нет.
    if (step.crashDuringProbe) {
      void call(step.probes[0]);
      await new Promise((r) => setTimeout(r, step.crashDuringProbe));
      writeFileSync(`${scenarioPath}.${role}.${index}.crashed`, String(process.ppid));
      process.kill(process.ppid, 'SIGKILL');
      child.kill('SIGKILL');
      process.exit(9);
    }
    probeRuns = step.probesConcurrent
      ? await Promise.all(step.probes.map(call))
      : await step.probes.reduce(
          (p, argv) => p.then(async (all) => [...all, await call(argv)]),
          Promise.resolve([]),
        );
    child.kill();
  }
  writeFileSync(`${scenarioPath}.${role}.${index}.probes`, JSON.stringify(probeRuns));
}
// ID находок — только из фактически полученного запроса controller:
// `$open:N` / `$closed:N` — N-я открытая/закрытая находка раздела истории.
const section = (header) => {
  const m = prompt.match(new RegExp('^' + header + '[^\\n]*\\n(\\[.*\\])$', 'm'));
  return m ? JSON.parse(m[1]) : [];
};
const issued = {
  open: section('Open review findings issued by the controller'),
  closed: section('Closed or withdrawn review findings \\(history\\)'),
};
writeFileSync(`${scenarioPath}.${role}.${index}.findings`, JSON.stringify(issued));
const cite = (text) =>
  text
    .replace(/\$probe:(\d+)/g, (_m, n) => probeRuns[Number(n)]?.runId ?? 'missing')
    .replace(
      /\$(open|closed):(\d+)/g,
      (_m, k, n) => issued[k][Number(n)]?.id ?? `missing-${k}-${n}`,
    );
if (step.result) step.result = JSON.parse(cite(JSON.stringify(step.result)));
if (step.stderr) process.stderr.write(step.stderr + '\n');
// Аварийное завершение controller посреди логического ревью (барьер теста
// рестарта): процесс harness убит до получения этого ответа.
if (step.crashHarness) {
  writeFileSync(`${scenarioPath}.${role}.${index}.crashed`, String(process.ppid));
  process.kill(process.ppid, 'SIGKILL');
  process.exit(9);
}
const started = step.started !== false;
const out = (event) => process.stdout.write(JSON.stringify(event) + '\n');
if (runtime === 'codex') {
  out({ type: 'thread.started', thread_id: 'fixture' });
  if (started) out({ type: 'item.completed', item: { type: 'agent_message', text: 'fixture' } });
  if (role === 'reviewer' && step.observedCommand)
    out({
      type: 'item.completed',
      item: {
        type: 'command_execution',
        command: step.observedCommand,
        exit_code: 0,
        aggregated_output: 'ok',
        status: 'completed',
      },
    });
  if (started)
    out({
      type: 'turn.completed',
      usage: { input_tokens: 10, output_tokens: 5, cached_input_tokens: 0 },
    });
  if (step.exit) process.exit(step.exit);
  writeFileSync(arg('--output-last-message'), step.raw ?? JSON.stringify(step.result));
} else {
  out({ type: 'system', subtype: 'init', model: step.model ?? 'claude-fixture' });
  if (started)
    out({ type: 'assistant', message: { content: [{ type: 'text', text: 'fixture' }] } });
  if (step.exit) {
    out({ type: 'result', is_error: true, result: step.stderr ?? 'failed' });
    process.exit(step.exit);
  }
  out({
    type: 'result',
    is_error: false,
    structured_output: step.raw !== undefined ? step.raw : step.result,
    usage: {
      input_tokens: 10,
      output_tokens: 5,
      cache_read_input_tokens: 0,
      cache_creation_input_tokens: 0,
    },
    // Стоимость, о которой сообщает провайдер: тесты бюджетов задают её шагом сценария.
    total_cost_usd: step.costUsd ?? 0,
  });
}
