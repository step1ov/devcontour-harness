  "limitations": [
    {
      "id": "no-baseline",
      "text": "There is no before-harness baseline: the report does not compare with work done without the harness."
    },
    {
      "id": "actions-not-recorded",
      "text": "Human actions are counted only where a person is recorded as the actor (operator recovery decisions); retries, resets, cancellations and base moves have no recorded actor yet, so tasks that needed no human action are not measurable yet."
    },
    {
      "id": "check-network",
      "text": "Network or registry errors inside checks are classified as check failures, so rejections by checks can be overstated; setup checks are marked."
    },
    {
      "id": "environment-cause",
      "text": "Environment failures have no recorded sub-cause (sandbox, network, provider, lease)."
    },
    {
      "id": "reviewer-precision",
      "text": "A rejected candidate is not proof of a real defect: reviewer precision is not measured; withdrawn findings are only a proxy."
    },
    {
      "id": "escaped-defects",
      "text": "Defects found after merge and human time outside the tool are not visible to the harness."
    },
    {
      "id": "unclassified",
      "text": "1 failed attempt without a failure class (recorded before classification) is shown as unclassified, not as defects."
    },
    {
      "id": "timings",
      "text": "4 of 13 attempts have no stage timings; stage time covers the rest."
    },
    {
      "id": "calls",
      "text": "2 of 13 attempts have no call records, so their spend is unknown."
    },
    {
      "id": "holds-actor",
      "text": "Holds and cancelled attempts record no actor (host operations hold tasks too), so they are not counted as human actions."
    },
    {
      "id": "prices",
      "text": "1 of 10 calls have no known price (no tariff 1, incomplete telemetry 0, active 0, abandoned 0); spend is a lower bound."
    },
    {
      "id": "lead-fallback",
      "text": "1 accepted task started from the task approval time, which a re-approval overwrites."
    },
    {
      "id": "events-from",
      "text": "Pauses and approvals are counted from events, which start at 2026-10-05T07:50:00.000Z."
    },
    {
      "id": "engines",
      "text": "Several engine versions in the window (0.1.0-alpha.29, 0.1.0-alpha.30, unknown): weeks where the version changed are marked."
    }
  ]
