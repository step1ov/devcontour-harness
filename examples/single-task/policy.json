{
  "policyVersion": 1,
  "repositories": [
    {
      "id": "app",
      "path": ".",
      "targetRef": "refs/heads/harness/accepted",
      "gates": [
        {
          "id": "unit",
          "kind": "test",
          "command": ["node", "test/run.js"],
          "report": {
            "type": "junit",
            "path": "test-results/junit.xml"
          }
        }
      ],
      "protectedPaths": [
        ".github/",
        "test/",
        "policy.json",
        "policy-same-vendor.json",
        "graph.json"
      ]
    }
  ],
  "roles": {
    "developer": {
      "writer": {
        "runtime": "claude"
      }
    }
  },
  "review": {
    "code": {
      "reviewer": {
        "runtime": "codex"
      }
    },
    "plan": {
      "reviewer": {
        "runtime": "codex"
      }
    },
    "contract": {
      "reviewer": {
        "runtime": "codex"
      }
    }
  }
}
