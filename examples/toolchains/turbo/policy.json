{
  "policyVersion": 1,
  "repositories": [
    {
      "id": "app",
      "path": "repo",
      "targetRef": "refs/heads/harness/accepted",
      "prepare": [
        {
          "id": "install",
          "command": ["pnpm", "install", "--frozen-lockfile"],
          "timeoutMs": 600000
        }
      ],
      "gates": [
        {
          "id": "check",
          "kind": "check",
          "command": [
            "pnpm",
            "exec",
            "turbo",
            "run",
            "check",
            "--filter=@fx/label",
            "--output-logs=full"
          ],
          "timeoutMs": 240000
        },
        {
          "id": "unit-tests",
          "kind": "test",
          "command": [
            "pnpm",
            "exec",
            "turbo",
            "run",
            "test",
            "--filter=@fx/label",
            "--force",
            "--output-logs=full"
          ],
          "timeoutMs": 240000,
          "dependsOn": ["check"],
          "report": {
            "type": "junit",
            "path": "packages/label/.reports/junit.xml"
          }
        }
      ],
      "environment": {
        "values": {
          "TURBO_TELEMETRY_DISABLED": "1",
          "TURBO_NO_UPDATE_NOTIFIER": "1",
          "DO_NOT_TRACK": "1"
        }
      },
      "toolchain": {
        "tools": {
          "pnpm": "10.12.3"
        },
        "packageManagers": {
          ".": "pnpm"
        }
      },
      "protectedPaths": [
        ".github/",
        ".githooks/",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "turbo.json",
        "packages/label/test/",
        "packages/label/package.json",
        "packages/checker/",
        "REQUIREMENTS.md"
      ]
    }
  ],
  "roles": {
    "developer": {
      "writer": {
        "runtime": "claude"
      }
    }
  },
  "review": {
    "code": {
      "reviewer": {
        "runtime": "codex"
      }
    },
    "plan": {
      "reviewer": {
        "runtime": "codex"
      }
    },
    "contract": {
      "reviewer": {
        "runtime": "codex"
      }
    }
  },
  "isolation": {
    "mode": "none",
    "domains": []
  },
  "maxAttempts": 2,
  "runTimeoutMs": 900000
}
