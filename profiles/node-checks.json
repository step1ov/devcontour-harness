{
  "id": "node-checks",
  "version": "0.2.0",
  "capabilities": [
    "node",
    "typescript",
    "unit-tests"
  ],
  "protectedPaths": [
    "package.json",
    "package-lock.json"
  ],
  "gates": [
    {
      "id": "install",
      "kind": "check",
      "command": [
        "npm",
        "ci"
      ],
      "timeoutMs": 240000
    },
    {
      "id": "typecheck",
      "kind": "check",
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "timeoutMs": 240000,
      "dependsOn": [
        "install"
      ]
    },
    {
      "id": "unit-tests",
      "kind": "test",
      "command": [
        "npm",
        "run",
        "test:devcontour"
      ],
      "timeoutMs": 240000,
      "dependsOn": [
        "typecheck"
      ],
      "report": {
        "type": "junit",
        "path": ".reports/junit.xml"
      }
    }
  ],
  "contextPacks": [
    {
      "id": "technique-testing",
      "version": "1.0.0",
      "roles": [
        "backend",
        "engine",
        "qa",
        "qa-web",
        "qa-admin",
        "qa-mobile",
        "qa-api"
      ],
      "files": [
        ".agents/context/technique-testing.md"
      ],
      "references": [
        ".agents/context/vendor/matt-pocock/skills--engineering--tdd--SKILL.md",
        ".agents/context/vendor/matt-pocock/skills--engineering--tdd--tests.md",
        ".agents/context/vendor/matt-pocock/skills--engineering--tdd--mocking.md"
      ]
    }
  ]
}
